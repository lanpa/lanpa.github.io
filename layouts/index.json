{{- $items := slice -}}
{{- range .Site.RegularPages -}}
  {{- $items = $items | append (dict
    "title"   .Title
    "url"     .RelPermalink
    "section" .Section
    "summary" (.Summary | plainify | chomp | truncate 200)
    "tags"    (.Params.tags | default slice)
    "date"    (.Date.Format "2006-01-02")
  ) -}}
{{- end -}}
{{ $items | jsonify }}
